<?xml version="1.0"?>
 <robot name="csy_car" xmlns:xacro="shturl.cc/sHrxXwoTisxeMVBJ5OW">
   <!-- ========== 1. 颜色材质 ========== -->
   <material name="blue">
     <color rgba="0.2 0.4 0.8 1.0"/>
   </material>
   <material name="black">
     <color rgba="0.1 0.1 0.1 1.0"/>
   </material>
   <material name="grey">
     <color rgba="0.5 0.5 0.5 1.0"/>
   </material>
   <material name="white">
     <color rgba="0.9 0.9 0.9 1.0"/>
   </material>
   <!-- ========== 2. 尺寸参数（单位：米 / 千克） ========== -->
   <xacro:property name="base_length"    value="0.50"/>
   <xacro:property name="base_width"     value="0.30"/>
   <xacro:property name="base_height"    value="0.10"/>
   <xacro:property name="base_mass"      value="5.0"/>
   <xacro:property name="wheel_radius"   value="0.05"/>
   <xacro:property name="wheel_width"    value="0.04"/>
   <xacro:property name="wheel_mass"     value="0.5"/>
   <xacro:property name="wheel_sep"      value="0.30"/>
   <xacro:property name="caster_radius"  value="0.03"/>
   <xacro:property name="caster_mass"    value="0.1"/>
   <xacro:property name="lidar_radius"   value="0.03"/>
   <xacro:property name="lidar_height"   value="0.05"/>
   <xacro:property name="lidar_mass"     value="0.1"/>
   <!-- ========== 3. 惯性矩阵宏（长方体） ========== -->
   <xacro:macro name="box_inertia" params="m x y z">
     <inertial>
       <mass value="${m}"/>
       <origin xyz="0 0 0"/>
       <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
                iyy="${m*(x*x+z*z)/12}" iyz="0"
                izz="${m*(x*x+y*y)/12}"/>
     </inertial>
   </xacro:macro>
   <!-- ========== 4. 惯性矩阵宏（圆柱体，绕Y轴） ========== -->
   <xacro:macro name="cylinder_inertia_y" params="m r h">
     <inertial>
       <mass value="${m}"/>
       <origin xyz="0 0 0"/>
       <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
                iyy="${m*r*r/2}"          iyz="0"
                izz="${m*(3*r*r+h*h)/12}"/>
     </inertial>
   </xacro:macro>
   <!-- ========== 5. 底盘 base_link ========== -->
   <link name="base_link">
     <visual>
       <origin xyz="0 0 ${wheel_radius + base_height/2}" rpy="0 0 0"/>
       <geometry>
         <box size="${base_length} ${base_width} ${base_height}"/>
       </geometry>
       <material name="blue"/>
     </visual>
     <collision>
       <origin xyz="0 0 ${wheel_radius + base_height/2}" rpy="0 0 0"/>
       <geometry>
         <box size="${base_length} ${base_width} ${base_height}"/>
       </geometry>
     </collision>
     <inertial>
       <origin xyz="0 0 ${wheel_radius + base_height/2}"/>
       <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
     </inertial>
   </link>
   <!-- ========== 6. 左驱动轮 ========== -->
   <link name="left_wheel">
     <visual>
       <origin rpy="1.5707963 0 0"/>
       <geometry>
         <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
       </geometry>
       <material name="black"/>
     </visual>
     <collision>
       <origin rpy="1.5707963 0 0"/>
       <geometry>
         <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
       </geometry>
     </collision>
     <xacro:cylinder_inertia_y m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
   </link>
   <joint name="left_wheel_joint" type="continuous">
     <parent link="base_link"/>
     <child  link="left_wheel"/>
     <origin xyz="0 ${wheel_sep/2} ${wheel_radius}" rpy="0 0 0"/>
     <axis xyz="0 1 0"/>
     <limit effort="30" velocity="10"/>
   </joint>
   <!-- ========== 7. 右驱动轮 ========== -->
   <link name="right_wheel">
     <visual>
       <origin rpy="1.5707963 0 0"/>
       <geometry>
         <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
       </geometry>
       <material name="black"/>
     </visual>
     <collision>
       <origin rpy="1.5707963 0 0"/>
       <geometry>
         <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
       </geometry>
     </collision>
     <xacro:cylinder_inertia_y m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
   </link>
   <joint name="right_wheel_joint" type="continuous">
     <parent link="base_link"/>
     <child  link="right_wheel"/>
     <origin xyz="0 ${-wheel_sep/2} ${wheel_radius}" rpy="0 0 0"/>
     <axis xyz="0 1 0"/>
     <limit effort="30" velocity="10"/>
   </joint>
   <!-- ========== 8. 前万向轮（固定支撑） ========== -->
   <link name="front_caster">
     <visual>
       <geometry>
         <sphere radius="${caster_radius}"/>
       </geometry>
       <material name="grey"/>
     </visual>
     <collision>
       <geometry>
         <sphere radius="${caster_radius}"/>
       </geometry>
     </collision>
     <inertial>
       <mass value="${caster_mass}"/>
       <inertia ixx="0.0001" ixy="0" ixz="0"
                iyy="0.0001" iyz="0"
                izz="0.0001"/>
     </inertial>
   </link>
   <joint name="front_caster_joint" type="fixed">
     <parent link="base_link"/>
     <child  link="front_caster"/>
     <origin xyz="${base_length/2 - 0.06} 0 ${caster_radius}"/>
   </joint>
   <!-- ========== 9. 后万向轮（固定支撑） ========== -->
   <link name="rear_caster">
     <visual>
       <geometry>
         <sphere radius="${caster_radius}"/>
       </geometry>
       <material name="grey"/>
     </visual>
     <collision>
       <geometry>
         <sphere radius="${caster_radius}"/>
       </geometry>
     </collision>
     <inertial>
       <mass value="${caster_mass}"/>
       <inertia ixx="0.0001" ixy="0" ixz="0"
                iyy="0.0001" iyz="0"
                izz="0.0001"/>
     </inertial>
   </link>
   <joint name="rear_caster_joint" type="fixed">
     <parent link="base_link"/>
     <child  link="rear_caster"/>
     <origin xyz="${-base_length/2 + 0.06} 0 ${caster_radius}"/>
   </joint>
   <!-- ========== 10. 激光雷达 ========== -->
   <link name="lidar_link">
     <visual>
       <origin xyz="0 0 0" rpy="0 0 0"/>
       <geometry>
         <cylinder radius="${lidar_radius}" height="${lidar_height}"/>
       </geometry>
       <material name="white"/>
     </visual>
     <collision>
       <geometry>
         <cylinder radius="${lidar_radius}" height="${lidar_height}"/>
       </geometry>
     </collision>
     <inertial>
       <mass value="${lidar_mass}"/>
       <inertia ixx="0.0001" ixy="0" ixz="0"
                iyy="0.0001" iyz="0"
                izz="0.0001"/>
     </inertial>
   </link>
   <joint name="lidar_joint" type="fixed">
     <parent link="base_link"/>
     <child  link="lidar_link"/>
     <origin xyz="0 0 ${wheel_radius + base_height + lidar_height/2}"/>
   </joint>
   <!-- ========== 11. Gazebo 差速驱动插件 ========== -->
   <gazebo>
     <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
       <rosDebugLevel>Info</rosDebugLevel>
       <publishWheelTF>true</publishWheelTF>
       <publishTf>true</publishTf>
       <publishWheelJointState>true</publishWheelJointState>
       <alwaysOn>true</alwaysOn>
       <updateRate>50.0</updateRate>
       <leftJoint>left_wheel_joint</leftJoint>
       <rightJoint>right_wheel_joint</rightJoint>
       <wheelSeparation>${wheel_sep}</wheelSeparation>
       <wheelDiameter>${2*wheel_radius}</wheelDiameter>
       <broadcastTF>true</broadcastTF>
       <wheelTorque>30</wheelTorque>
       <wheelAcceleration>1.8</wheelAcceleration>
       <commandTopic>cmd_vel</commandTopic>
       <odometryFrame>odom</odometryFrame>
       <odometryTopic>odom</odometryTopic>
       <robotBaseFrame>base_link</robotBaseFrame>
     </plugin>
   </gazebo>
   <!-- ========== 12. Gazebo 激光雷达插件 ========== -->
   <gazebo reference="lidar_link">
     <sensor type="ray" name="head_laser">
       <pose>0 0 0 0 0 0</pose>
       <visualize>true</visualize>
       <update_rate>10</update_rate>
       <ray>
         <scan>
           <horizontal>
             <samples>360</samples>
             <resolution>1</resolution>
             <min_angle>-3.14159265</min_angle>
             <max_angle>3.14159265</max_angle>
           </horizontal>
         </scan>
         <range>
           <min>0.10</min>
           <max>10.0</max>
           <resolution>0.01</resolution>
         </range>
       </ray>
       <plugin name="laser_plugin" filename="libgazebo_ros_laser.so">
         <topicName>/scan</topicName>
         <frameName>lidar_link</frameName>
       </plugin>
     </sensor>
   </gazebo>
   <!-- ========== 13. Gazebo 颜色 ========== -->
   <gazebo reference="base_link">
     <material>Gazebo/Blue</material>
   </gazebo>
   <gazebo reference="left_wheel">
     <material>Gazebo/Black</material>
   </gazebo>
   <gazebo reference="right_wheel">
     <material>Gazebo/Black</material>
   </gazebo>
   <gazebo reference="front_caster">
     <material>Gazebo/Grey</material>
   </gazebo>
   <gazebo reference="rear_caster">
     <material>Gazebo/Grey</material>
   </gazebo>
   <gazebo reference="lidar_link">
     <material>Gazebo/White</material>
   </gazebo>
 </robot>